{
  "name": "sketch-ui-color-palette",
  "version": "5.3.5",
  "private": true,
  "description": "UI Color Palette is a Sketch plugin that creates, manages, exports, and publishes consistent and accessible color palettes.",
  "author": "Aurélien Grimaud",
  "license": "MIT",
  "repository": "https://github.com/a-ng-d/sketch-ui-color-palette",
  "keywords": [
    "color",
    "color-scheme",
    "lch",
    "color-system",
    "ui-color",
    "sketch-plugin"
  ],
  "workspaces": [
    "packages/ui-ui-color-palette",
    "packages/ui-ui-color-palette/packages/auth-yelbolt",
    "packages/ui-ui-color-palette/packages/auth-yelbolt/ui-color-palette",
    "packages/ui-ui-color-palette/packages/auth-yelbolt-worker",
    "packages/ui-ui-color-palette/packages/announcements-yelbolt-worker",
    "packages/ui-ui-color-palette/packages/cors-yelbolt-worker"
  ],
  "engines": {
    "sketch": ">=3.0"
  },
  "scripts": {
    "init:submodules": "cd packages/ui-ui-color-palette && git submodule update --init --recursive",
    "install:ext": "npm install --workspaces && npm install --workspace=packages/ui-ui-color-palette/packages/auth-yelbolt --workspaces && npm install --prefix packages/ui-ui-color-palette/packages/auth-yelbolt/ui-color-palette",
    "update:ext": "git submodule update --remote --merge",
    "update:unoff": "npm i @unoff/ui@latest @unoff/utils@latest",
    "update:uicp": "npm i @yelbolt/engine-ui-color-palette@latest",
    "start:ext": "npm run start:ext -w ui-ui-color-palette",
    "start:dev": "npm run build & npm run hotreload",
    "build": "node scripts/copy-sketch-bundle.mjs && cross-env npx vite build --mode development & cross-env IS_PLUGIN=true npx vite build --mode development",
    "build:prod": "node scripts/copy-sketch-bundle.mjs && cross-env npx vite build --mode production && cross-env IS_PLUGIN=true npx vite build --mode production",
    "hotreload": "find ./sketch-ui-color-palette.sketchplugin -name '*js' | entr -r /Applications/Sketch.app/Contents/MacOS/Sketch",
    "audit:prod": "npm audit --omit=dev",
    "typecheck": "npx tsc --noEmit",
    "lint": "npx eslint ./src ./resources --fix --ext .js,.jsx,.ts,.tsx .",
    "format": "npx prettier './src' './resources' --write",
    "log": "tail -f ~/Library/Logs/com.bohemiancoding.sketch3/'Plugin Output.log'"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "@sentry/vite-plugin": "^5.4.1",
    "@sketch-hq/sketch-file-format-ts": "^6.5.0",
    "@types/chroma-js": "^3.1.1",
    "@types/file-saver": "^2.0.5",
    "@types/mixpanel-browser": "^2.66.0",
    "@types/node": "^22.14.0",
    "@types/react": "^17.0.37",
    "@types/react-dom": "^17.0.11",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "cross-env": "^10.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.26.0",
    "eslint-plugin-react": "^7.25.3",
    "prettier": "^3.2.5",
    "prettier-plugin-css-order": "^2.1.2",
    "sketch-app-types": "^0.1.1",
    "typescript": "^5.4.3",
    "vite": "^6.2.5",
    "vite-plugin-css-injected-by-js": "^3.5.2"
  },
  "dependencies": {
    "@sentry/react": "^8.8.0",
    "@supabase/supabase-js": "^2.44.2",
    "sketch-module-web-view": "^3.1.4",
    "ui-ui-color-palette": "*"
  },
  "overrides": {
    "@unoff/utils": "^0.9.0",
    "prismjs": "^1.30.0"
  },
  "allowScripts": {
    "@sentry/cli": true,
    "@swc/core": true,
    "esbuild": true
  }
}
